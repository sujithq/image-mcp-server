# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_IMAGE_MODEL=gpt-image-2
AZURE_OPENAI_IMAGE_FALLBACK_MODEL=gpt-image-1.5

# Azure Authentication (for local development with service principal)
# In production, use managed identity instead
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Image Output Configuration
IMAGE_OUTPUT_DIR=./output/images

# Transport Configuration
# Options: stdio, sse, both
MCP_TRANSPORT_MODE=stdio

# SSE Server Configuration (only needed if using sse or both)
SSE_PORT=3000
SSE_HOST=localhost

# Logging Configuration
LOG_LEVEL=info
